# YAMORA Retails Production Environment Configuration Template

# Secret Key (Set a strong random key in production)
SECRET_KEY=yamora-retails-super-secret-production-key-2026

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false
SECURE_COOKIES=false

# Database Configuration (Set USE_MYSQL=true for MySQL/MariaDB deployment)
USE_MYSQL=false
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=yamoraretails_db

# Production SQLite Fallback URL (used if USE_MYSQL=false)
DATABASE_URL=sqlite:///yamoraretails.db
